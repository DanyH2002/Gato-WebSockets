@page
@model gaton.Pages.ForgotPasswordModel
@using gaton.Model
@{
    ViewData["Title"] = "Recuperar contraseña";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="text-center mb-4">Recuperar Contraseña</h2>

            <form method="post" class="p-4 rounded shadow-sm bg-light">
                <div class="form-floating mb-3">
                    <input type="email" class="form-control" asp-for="RecoverRequest.Email" placeholder="Correo" />
                    <label asp-for="RecoverRequest.Email">Correo electrónico</label>
                    <span asp-validation-for="RecoverRequest.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <select class="form-select" asp-for="RecoverRequest.Question"
                        asp-items="Html.GetEnumSelectList<SecurityQuestion>()">
                    </select>
                    <label asp-for="RecoverRequest.Question">Pregunta de seguridad</label>
                    <span asp-validation-for="RecoverRequest.Question" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input type="text" class="form-control" asp-for="RecoverRequest.SecurityAnswer"
                        placeholder="Respuesta" />
                    <label asp-for="RecoverRequest.SecurityAnswer">Respuesta de seguridad</label>
                    <span asp-validation-for="RecoverRequest.SecurityAnswer" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input type="password" id="passwordInput" class="form-control" asp-for="RecoverRequest.NewPassword"
                        placeholder="Nueva contraseña" />
                    <label asp-for="RecoverRequest.NewPassword">Nueva contraseña</label>
                    <span asp-validation-for="RecoverRequest.NewPassword" class="text-danger"></span>
                    <ul class="list-unstyled mt-2" id="passwordHints">
                        <li><i id="lenCheck" class="bi bi-circle-fill text-muted me-2"></i> Entre 6 y 16 caracteres</li>
                        <li><i id="upperCheck" class="bi bi-circle-fill text-muted me-2"></i> Al menos una mayúscula
                        </li>
                        <li><i id="lowerCheck" class="bi bi-circle-fill text-muted me-2"></i> Al menos una minúscula
                        </li>
                        <li><i id="numberCheck" class="bi bi-circle-fill text-muted me-2"></i> Al menos un número</li>
                    </ul>

                </div>

                @if (!string.IsNullOrEmpty(Model.ResultMessage))
                {
                    <div class="alert alert-info">@Model.ResultMessage</div>
                }

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Actualizar contraseña</button>
                    <a href="/Index" class="btn btn-outline-secondary">Volver al login</a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .list-unstyled {
        padding-left: 0;
        margin-top: 10px;
        list-style: none;
    }
</style>
<script>
    document.getElementById("passwordInput").addEventListener("input", function () {
        const value = this.value;
        toggleValidationIcon("lenCheck", value.length >= 6 && value.length <= 16);
        toggleValidationIcon("upperCheck", /[A-Z]/.test(value));
        toggleValidationIcon("lowerCheck", /[a-z]/.test(value));
        toggleValidationIcon("numberCheck", /\d/.test(value));
    });
    function toggleValidationIcon(id, isValid) {
        const icon = document.getElementById(id);
        icon.classList.replace(isValid ? "text-muted" : "text-success", isValid ? "text-success" : "text-muted");
        icon.classList.replace(isValid ? "bi-circle-fill" : "bi-check-circle-fill", isValid ? "bi-check-circle-fill" : "bi-circle-fill");
    }
</script>