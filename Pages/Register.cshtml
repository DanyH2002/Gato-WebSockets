@page
@model gaton.Pages.RegisterModel
@using gaton.Model
@{
    ViewData["Title"] = "Registro";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="text-center mb-4">Registro</h2>
            <form method="post" class="p-4 rounded shadow-sm bg-light">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" asp-for="Name" placeholder="Username" />
                    <label asp-for="Name">Username</label>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input type="email" class="form-control" asp-for="Email" placeholder="Correo electrónico" />
                    <label asp-for="Email">Correo electrónico</label>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input type="password" id="passwordInput" class="form-control" asp-for="Password"
                        placeholder="Contraseña" />
                    <label asp-for="Password">Contraseña</label>
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <ul class="list-unstyled mt-2" id="passwordHints">
                        <li><i id="lenCheck" class="bi bi-circle-fill text-muted me-2"></i> Entre 6 y 16 caracteres</li>
                        <li><i id="upperCheck" class="bi bi-circle-fill text-muted me-2"></i> Al menos una mayúscula
                        </li>
                        <li><i id="lowerCheck" class="bi bi-circle-fill text-muted me-2"></i> Al menos una minúscula
                        </li>
                        <li><i id="numberCheck" class="bi bi-circle-fill text-muted me-2"></i> Al menos un número</li>
                    </ul>
                </div>
                <div class="form-floating mb-3">
                    <select class="form-select" asp-for="Question"
                        asp-items="Html.GetEnumSelectList<SecurityQuestion>()">
                    </select>
                    <label asp-for="Question">Pregunta de seguridad</label>
                    <span asp-validation-for="Question" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input type="text" class="form-control" asp-for="SecurityAnswer"
                        placeholder="Pregunta de seguridad" />
                    <label asp-for="SecurityAnswer">Respuesta de seguridad</label>
                    <span asp-validation-for="SecurityAnswer" class="text-danger"></span>
                </div>
                @if (!string.IsNullOrEmpty(Model.RegisterError))
                {
                    <div class="alert alert-danger">@Html.Raw(Model.RegisterError)</div>
                }
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Registrate para jugar</button>
                    <button type="button" class="btn btn-outline-secondary"
                        onclick="window.location.href = '@Url.Page("/Index")';"> ¿Tienes una cuenta? Inicia sesión
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<style>
    .list-unstyled {
        padding-left: 0;
        margin-top: 10px;
        list-style: none;
    }
</style>
<script>
    document.getElementById("passwordInput").addEventListener("input", function () {
        const value = this.value;
        toggleValidationIcon("lenCheck", value.length >= 6 && value.length <= 16);
        toggleValidationIcon("upperCheck", /[A-Z]/.test(value));
        toggleValidationIcon("lowerCheck", /[a-z]/.test(value));
        toggleValidationIcon("numberCheck", /\d/.test(value));
    });
    function toggleValidationIcon(id, isValid) {
        const icon = document.getElementById(id);
        icon.classList.replace(isValid ? "text-muted" : "text-success", isValid ? "text-success" : "text-muted");
        icon.classList.replace(isValid ? "bi-circle-fill" : "bi-check-circle-fill", isValid ? "bi-check-circle-fill" : "bi-circle-fill");
    }
</script>
