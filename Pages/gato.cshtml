@page
@model gaton.Pages.GatoModel
@{
    ViewData["Title"] = "Juego del Gato";
    ViewData["BodyClass"] = "gato-page";
}

<div class="titulo">¡Gato!</div>
<hr />

<div id="inicioPartida" class="alert alert-info text-center d-none" role="alert">
    <strong>🎮 La partida ha comenzado. ¡Buena suerte!</strong>
</div>

<div class="contenedor-gato">
    <div class="jugador">
        <h3>Jugador 1</h3>
        <div class="icono-turno" id="turnoO"></div>
    </div>

    <div class="centro">
        <h2 class="mensaje" id="mensajeJuego">Esperando partida...</h2>
        <h4 id="turnoActual" class="text-info mt-2"></h4>
        <div id="timerTurno" class="badge bg-warning text-dark fs-5 mt-2"></div>

        <div class="tablero">
            @for (int i = 0; i < 9; i++)
            {
                <button type="button" class="casilla" id="casilla-@i"></button>
            }
        </div>

        <button class="btn btn-outline-secondary mt-3" type="button" onclick="window.location.href = '/Lobby';">
            ⬅ Volver al Lobby
        </button>
    </div>

    <div class="jugador">
        <h3>Jugador 2</h3>
        <div class="icono-turno" id="turnoX"></div>
    </div>
</div>

<hr />

<style>
    .titulo {
        text-align: center;
        font-size: 2rem;
        margin: 10px 0;
        font-weight: bold;
    }

    .contenedor-gato {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 40px;
        margin-top: 20px;
    }

    .jugador {
        text-align: center;
        font-size: 1.2rem;
    }

    .icono-turno {
        font-size: 5rem;
        margin-top: 10px;
        transition: transform 0.3s ease;
    }

    .centro {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .mensaje {
        margin-bottom: 10px;
        font-size: 1.5rem;
        font-weight: bold;
    }

    .tablero {
        display: grid;
        grid-template-columns: repeat(3, 100px);
        grid-template-rows: repeat(3, 100px);
        gap: 5px;
    }

    .casilla {
        background-color: #8dcfcc;
        border: 2px solid #333;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 2.5rem;
        cursor: pointer;
        font-weight: bold;
        color: black;
        transition: background-color 0.3s ease;
    }

    .casilla:disabled {
        background-color: #43ba74;
        cursor: default;
    }

    .casilla:hover:not(:disabled) {
        background-color: #e0e0e0;
    }

    hr {
        margin: 20px 0;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<script>
    const playerName = sessionStorage.getItem("PlayerName");
    const socket = new WebSocket(`ws://localhost:9001/${playerName}`);
    let tiempoRestante = 15;
    let intervaloTimer;

    socket.onopen = () => {
        socket.send(JSON.stringify({
            action_type: "identify",
            value: { name: playerName }
        }));
    };

    socket.onmessage = event => {
        const data = JSON.parse(event.data);

        if (data.action === "update-board") {
            actualizarTablero(data.tablero, data.turno, data.ganador);
        }

        if (data.action === "endgame") {
            mostrarMensajeFinal(data.msg);
        }

        if (data.action === "timeout") {
            mostrarMensajeFinal(data.msg);
        }

        if (data.action === "room-joined") {
            document.getElementById("inicioPartida").classList.remove("d-none");
        }
    };

    function enviarMovimiento(index) {
        socket.send(JSON.stringify({
            action_type: "move",
            value: {
                name: playerName,
                casilla: index
            }
        }));
    }

    function actualizarTablero(tablero, turno, ganador) {
        for (let i = 0; i < 9; i++) {
            const btn = document.getElementById(`casilla-${i}`);
            btn.textContent = tablero[i];
            btn.disabled = tablero[i] !== "" || ganador !== null;
        }

        const mensaje = document.getElementById("mensajeJuego");
        mensaje.textContent = ganador
            ? (ganador === "Empate" ? "Fue: Empate" : `Ganó: ${ganador}`)
            : `Turno: ${turno}`;

        document.getElementById("turnoX").textContent = turno === "X" ? "❌" : "";
        document.getElementById("turnoO").textContent = turno === "O" ? "⭕" : "";

        const miSimbolo = obtenerSimboloJugador();
        const turnoActual = document.getElementById("turnoActual");
        turnoActual.textContent = turno === miSimbolo
            ? "🕹️ ¡Es tu turno!"
            : "⏳ Esperando al oponente...";

        iniciarTimer();
    }

    function obtenerSimboloJugador() {
        return playerName.endsWith("X") ? "X" : "O";
    }

    function iniciarTimer() {
        clearInterval(intervaloTimer);
        tiempoRestante = 15;
        const timerDiv = document.getElementById("timerTurno");
        timerDiv.textContent = `⏱ ${tiempoRestante}s`;

        intervaloTimer = setInterval(() => {
            tiempoRestante--;
            timerDiv.textContent = `⏱ ${tiempoRestante}s`;
            if (tiempoRestante <= 0) {
                clearInterval(intervaloTimer);
            }
        }, 1000);
    }

    function mostrarMensajeFinal(msg) {
        const mensaje = document.getElementById("mensajeJuego");
        mensaje.textContent = msg;

        if (msg.includes("Ganó")) {
            confetti({
                particleCount: 150,
                spread: 70,
                origin: { y: 0.6 }
            });
        }
    }

    for (let i = 0; i < 9; i++) {
        document.getElementById(`casilla-${i}`).addEventListener("click", () => {
            enviarMovimiento(i);
        });
    }
</script>