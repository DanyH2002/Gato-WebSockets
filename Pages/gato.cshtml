@page
@model gaton.Pages.GatoModel
@{
    ViewData["Title"] = "Juego del Gato";
}

<div class="titulo">¡Gato!</div>
<hr />

<div class="contenedor-gato">
    <div class="jugador">
        <h3>Jugador 1</h3>
        <div class="icono-turno">@((Model.turno == "O") ? "⭕" : "")</div>
    </div>

    <div class="centro">
        @if (!string.IsNullOrEmpty(Model.ganador))
        {
            <h2 class="mensaje">@((Model.ganador == "X" || Model.ganador == "O") ? $"Ganó: {Model.ganador}" : $"Fue: {Model.ganador}")</h2>
        }
        else
        {
            <h2 class="mensaje">Turno: @Model.turno</h2>
        }

        <form method="post">
            <input type="hidden" name="Turno" value="@Model.turno" />
            <div class="tablero">
                @for (int i = 0; i < 9; i++)
                {
                    <button type="submit" name="CasillaSeleccionada" value="@i" class="casilla" @(Model.tablero[i] != "" || !string.IsNullOrEmpty(Model.ganador) ? "disabled" : "")>
                        @Model.tablero[i]
                    </button>
                }
            </div>
        </form>

<form method="post" asp-page-handler="Reiniciar">
    <button class="reiniciar" type="submit">Reiniciar Juego</button>
</form>

<style>
    .tablero {
        display: grid;
        grid-template-columns: repeat(3, 100px);
        grid-template-rows: repeat(3, 100px);
        gap: 5px;
        }

    .casilla {
        background-color: #f17777;
        border: 2px solid #333;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 2.5rem;
        cursor: pointer;
        color:black;
        font-weight: bold;
        transition: background-color 0.3s ease;
        }
        
    .casilla:disabled {
        background-color: #f81e1e;
        cursor: default;
        color:black;
        font-weight: bold;
        transition: background-color 0.3s ease;
    }

    .casilla:hover:not(:disabled) {
        background-color: #e0e0e0;
    }
    
    .reiniciar{
        background-color: rgb(8, 66, 160);
        color: white;
        font-size: 1.2rem;
        padding: 10px 20px;
        border: none;
        margin-top: 20px;
        color: white;
        font-size: 2rem;
    }
</style>
 