@page
@model gaton.Pages.GatoModel
@{
    ViewData["Title"] = "Juego del Gato";
    ViewData["BodyClass"] = "gato-page";
}

<div class="titulo">¡Gato!</div>
<hr />

<div id="inicioPartida" class="alert alert-info text-center d-none" role="alert">
    <strong>🎮 La partida ha comenzado. ¡Buena suerte!</strong>
</div>

<div class="contenedor-gato">
    <div class="jugador">
        <h3>Jugador 1</h3>
        <h4 id="nombreJugadorX" class="text-muted"></h4>
        <div class="icono-turno" id="turnoX"></div>
    </div>

    <div class="centro">
        <h2 class="mensaje" id="mensajeJuego">Esperando partida...</h2>
        <h4 id="turnoActual" class="text-info mt-2"></h4>
        <div id="timerTurno" class="badge bg-warning text-dark fs-5 mt-2"></div>

        <div class="tablero mt-3">
            @for (int i = 0; i < 9; i++)
            {
                <button type="button" class="casilla" id="casilla-@i"></button>
            }
        </div>

        <button class="btn btn-danger mt-3 ms-2" type="button" id="btnSalirPartida">
            🚪 Salir de la partida
        </button>
    </div>

    <div class="jugador">
        <h3>Jugador 2</h3>
        <h4 id="nombreJugadorO" class="text-muted"></h4>
        <div class="icono-turno" id="turnoO"></div>
    </div>
</div>

<hr />

<style>
    .titulo {
        text-align: center;
        font-size: 2rem;
        margin: 10px 0;
        font-weight: bold;
    }

    .contenedor-gato {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 40px;
        margin-top: 20px;
    }

    .jugador {
        text-align: center;
        font-size: 1.2rem;
    }

    .icono-turno {
        font-size: 5rem;
        margin-top: 10px;
        transition: transform 0.3s ease;
    }

    .centro {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .mensaje {
        margin-bottom: 10px;
        font-size: 1.5rem;
        font-weight: bold;
    }

    .tablero {
        display: grid;
        grid-template-columns: repeat(3, 100px);
        grid-template-rows: repeat(3, 100px);
        gap: 5px;
    }

    .casilla {
        background-color: #8dcfcc;
        border: 2px solid #333;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 2.5rem;
        cursor: pointer;
        font-weight: bold;
        color: black;
        transition: background-color 0.3s ease;
    }

    .casilla:disabled {
        background-color: #43ba74;
        cursor: default;
    }

    .casilla:hover:not(:disabled) {
        background-color: #e0e0e0;
    }

    #btnSalirPartida {
        z-index: 9999 !important;
        position: relative;
        pointer-events: auto;
    }

    hr {
        margin: 20px 0;
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<script>
    const playerName = sessionStorage.getItem("PlayerName");
    const wsProtocol = location.protocol === "https:" ? "wss" : "ws";
    const socket = new WebSocket(`${wsProtocol}://${location.host}/ws/${playerName}`);
    console.log(socket);

    let miSimbolo = null;
    let tiempoRestante = 15;
    let intervaloTimer;
    let saliendo = false;
    let currentRoomId = null;

    socket.onopen = () => {
        socket.send(JSON.stringify({
            action_type: "identify",
            value: { name: playerName }
        }));
        socket.send(JSON.stringify({
            action_type: "request-board-state",
            value: { name: playerName }
        }));
    };

    socket.onmessage = event => {
        console.log("Mensaje recibido:", event.data);
        const data = JSON.parse(event.data);

        if (data.action === "update-board") {
            console.log("Simbolo recibido:", data.simbolo);
            if (data.simbolo) {
                miSimbolo = data.simbolo;
            }
            currentRoomId = data.roomId;

            document.getElementById("nombreJugadorX").textContent = Object.entries(data.tableroSimbolos)
                .find(([nombre, simbolo]) => simbolo === "X")?.[0] || "X";

            document.getElementById("nombreJugadorO").textContent = Object.entries(data.tableroSimbolos)
                .find(([nombre, simbolo]) => simbolo === "O")?.[0] || "O";

            actualizarTablero(data.tablero, data.turno, data.ganador);
        }

        if (data.action === "endgame") {
            mostrarMensajeFinal(data.msg, data.ganador);
        }

        if (data.action === "timeout") {
            mostrarMensajeFinal(data.msg);
        }

        if (data.action === "room-joined") {
            console.log("esta en la sala: ", data.roomId);
        }

        if (data.action === "game-started") {
            console.log("Juego comenzando");
            const inicio = document.getElementById("inicioPartida");
            inicio.classList.remove("d-none");
            setTimeout(() => inicio.classList.add("d-none"), 2500);
        }


        if (data.action === "revancha-status") {
            document.getElementById("estadoRevancha").textContent =
                `Jugadores listos para revancha: ${data.jugadores}/${data.total}`;
        }

        if (data.action === "revancha-rechazada") {
            console.log("Revancha rechazada");
            sessionStorage.setItem("PlayerName", playerName);
            window.location.href = "/List";
        }

        if (data.action === "room-left") {
            if (data.msg === "Has abandonado la sala.") {
                sessionStorage.setItem("PlayerName", playerName);
                window.location.href = "/List";
            } else {
                const mensaje = document.getElementById("mensajeJuego");
                mensaje.textContent = `${data.msg}`;
                mensaje.classList.add("text-warning");
            }
        }

    };

    document.getElementById("btnSalirPartida").addEventListener("click", () => {
        if (saliendo) return;
        saliendo = true;
        socket.send(JSON.stringify({
            action_type: "leave",
            value: { name: playerName, roomId: currentRoomId }
        }));
    });


    function enviarMovimiento(index) {
        socket.send(JSON.stringify({
            action_type: "move",
            value: {
                name: playerName,
                casilla: index
            }
        }));
    }

    function actualizarTablero(tablero, turno, ganador) {
        // Limpiar controles previos
        if (ganador === null) {
            const controlesPrevios = document.querySelector(".mt-3.text-center");
            if (controlesPrevios) controlesPrevios.remove();
        }

        for (let i = 0; i < 9; i++) {
            const btn = document.getElementById(`casilla-${i}`);
            btn.textContent = tablero[i];
            btn.disabled = tablero[i] !== "" || ganador !== null;
        }

        const mensaje = document.getElementById("mensajeJuego");
        mensaje.textContent = ganador
            ? (ganador === "Empate" ? "Fue: Empate" : `Ganó: ${ganador}`)
            : `Turno: ${turno}`;

        document.getElementById("turnoX").textContent = turno === "X" ? "❌" : "";
        document.getElementById("turnoO").textContent = turno === "O" ? "⭕" : "";

        document.getElementById("turnoActual").textContent =
            turno === miSimbolo ? "🕹️ ¡Es tu turno!" : "⏳ Esperando al oponente...";

        iniciarTimer();
    }

    function iniciarTimer() {
        clearInterval(intervaloTimer);
        tiempoRestante = 15;
        const timerDiv = document.getElementById("timerTurno");
        timerDiv.textContent = `⏱ ${tiempoRestante}s`;

        intervaloTimer = setInterval(() => {
            tiempoRestante--;
            timerDiv.textContent = `⏱ ${tiempoRestante}s`;
            if (tiempoRestante <= 0) clearInterval(intervaloTimer);
        }, 1000);
    }

    function mostrarMensajeFinal(msg, ganador = null) {
        const mensaje = document.getElementById("mensajeJuego");
        mensaje.textContent = msg;
        clearInterval(intervaloTimer);

        if (ganador === miSimbolo) {
            confetti({
                particleCount: 150,
                spread: 70,
                origin: { y: 0.6 }
            });
            clearInterval(intervaloTimer);
        }
        if (msg.includes("abandono del oponente")) {
            mensaje.classList.add("text-success");
            mensaje.innerHTML = `🏆 <strong>${msg}</strong>`;
            clearInterval(intervaloTimer);
        } else {
            mensaje.classList.remove("text-success");
            clearInterval(intervaloTimer);
        }

        mostrarControlesRevancha();
    }


    function mostrarControlesRevancha() {
        if (document.getElementById("btnRevanchaSi")) return; // Si ya existen los botones, no hacer nada
        const container = document.createElement("div");
        container.className = "mt-3 text-center";
        container.innerHTML = `
        <h5>¿Quieres jugar una revancha?</h5>
        <button id="btnRevanchaSi" class="btn btn-success me-2">✅ Sí</button>
        <button id="btnRevanchaNo" class="btn btn-danger">❌ No</button>
        <p id="estadoRevancha" class="mt-2 text-muted"></p>
    `;
        document.querySelector(".centro").appendChild(container);

        document.getElementById("btnRevanchaSi").onclick = () => {
            socket.send(JSON.stringify({ action_type: "rematch-request", value: { name: playerName } }));
            //document.getElementById("estadoRevancha").textContent = "Esperando al otro jugador...";
            const estado = document.getElementById("estadoRevancha");
            estado.textContent = "Esperando al otro jugador...";
            estado.dataset.enviado = "true"; 
        };

        document.getElementById("btnRevanchaNo").onclick = () => {
            sessionStorage.setItem("PlayerName", playerName);
            socket.send(JSON.stringify({ action_type: "rematch-decline", value: { name: playerName } }));
            socket.close(1000, "Rechazo de revancha");
            setTimeout(() => {
                window.location.href = "/List";
            }, 250);
        };
    }

    for (let i = 0; i < 9; i++) {
        document.getElementById(`casilla-${i}`).addEventListener("click", () => {
            enviarMovimiento(i);
        });
    }
</script>