@page
@model LobbyModel
@{
    ViewData["Title"] = "Lobby";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h2 class="text-center mb-4">🎮 Bienvenido: @Model.NombreJugadorActual</h2>
    <div id="mensajeBienvenida" class="alert alert-success alert-dismissible fade show d-none text-center" role="alert">
        <span id="textoMensaje"></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
    <div id="notificacionSistema" class="alert alert-info text-center d-none" role="alert">
        <span id="notiTexto"></span>
    </div>

    <div class="row">
        <!-- Ranking -->
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Ranking de Jugadores</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Victorias</th>
                                <th>Empates</th>
                                <th>Partidas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stats in Model.Ranking)
                            {
                                <tr>
                                    <td>@stats.Player?.Name</td>
                                    <td>@stats.Victorias</td>
                                    <td>@stats.Empates</td>
                                    <td>@stats.PartidasJugadas</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Salas disponibles -->
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Salas disponibles</h5>
                    <button id="crearSalaBtn" class="btn btn-outline-light btn-sm">➕ Crear nueva sala</button>
                </div>
                <div class="card-body p-0">
                    <ul id="listaSalas" class="list-group list-group-flush"></ul>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let playerName = sessionStorage.getItem("PlayerName") || "@Model.NombreJugadorActual";
    if (!playerName || playerName === "undefined" || playerName.trim() === "") {
        alert("Error: No se pudo recuperar el nombre del jugador. Redirigiendo al login...");
        window.location.href = "/Index";
    } else {
        sessionStorage.setItem("PlayerName", playerName);
    }


    document.querySelector("h2.text-center.mb-4").textContent = `🎮 Bienvenido: ${playerName}`;
    const socket = new WebSocket(`ws://localhost:9001/${playerName}`);

    socket.onopen = () => {
        console.log(`Conectado como ${playerName}`);
        socket.send(JSON.stringify({
            action_type: "identify",
            value: { name: playerName }
        }));

        socket.send(JSON.stringify({
            action_type: "request-room-list",
            value: { name: playerName }
        }));
    };

    setInterval(() => {
        socket.send(JSON.stringify({
            action_type: "request-room-list",
            value: { name: playerName }
        }));
    }, 5000);


    socket.onmessage = event => { // Mensaje recibido del servidor
        const data = JSON.parse(event.data);
        console.log("Mensaje recibido:", data);

        if (data.action === "welcome") { // Mensaje de bienvenida
            mostrarMensajeBienvenida(data.msg);
            return;
        }

        if (data.action === "room-list") { // Lista de salas
            console.log("Salas recibidas:", data.rooms);
            renderizarSalas(data.rooms);
            console.log("⚡ Render de salas ejecutado.");
            return;
        }

        if (data.action === "room-joined") {
            mostrarNotificacion(data.msg);
            console.log("Se unio a sala: ", data.roomId);
            window.location.href = "/Gato";
            return;
        }

        if (data.action === "game-started") {
            console.log("Juego comenzando. Redirigiendo a /Gato");
            sessionStorage.setItem("redirecting", "true");
            //window.location.href = "/Gato";
            return;
        }

        if (data.action === "room-created") { // Crear una sala
            mostrarNotificacion(data.msg);
            return;
        }

        if (data.action === "room-left") {
            mostrarNotificacion(data.msg);
            socket.send(JSON.stringify({
                action_type: "request-room-list",
                value: { name: playerName }
            }));
        }


        if (["error", "join-failed", "leave-failed"].includes(data.action)) {
            mostrarNotificacion(data.msg);
            return;
        }
    };

    // Funciones para mostrar mensajes y notificaciones
    function mostrarMensajeBienvenida(msg) {
        const mensajeDiv = document.getElementById("mensajeBienvenida");
        const textoSpan = document.getElementById("textoMensaje");
        textoSpan.textContent = msg;
        mensajeDiv.classList.remove("d-none");
        setTimeout(() => mensajeDiv.classList.add("d-none"), 3000);
    }

    function mostrarNotificacion(texto) {
        const notiDiv = document.getElementById("notificacionSistema");
        const notiSpan = document.getElementById("notiTexto");
        notiSpan.textContent = texto;
        notiDiv.classList.remove("d-none");
        setTimeout(() => notiDiv.classList.add("d-none"), 3000);
    }

    // Funciones para renderizar salas 
    function renderizarSalas(salas) {
        try {
            const lista = document.getElementById("listaSalas");
            lista.innerHTML = "";
            salas.forEach(room => {
                const li = document.createElement("li");
                li.className = "list-group-item d-flex justify-content-between align-items-center";

                const descripcion = document.createElement("span");
                descripcion.innerHTML = `<strong>${room.RoomId}</strong> — ${room.isFull ? "🔴 En partida" : room.players.length === 1 ? "🟢 1 jugador esperando" : "⚪ Vacía"
                    }`;

                const boton = document.createElement("button");
                boton.className = "btn btn-sm";

                if (room.isFull) {
                    boton.classList.add("btn-danger");
                    boton.textContent = "Sala llena";
                    boton.disabled = true;
                } else {
                    boton.classList.add("btn-success");
                    boton.textContent = "Unirse";
                    boton.onclick = () => {
                        console.log(`Unirse a la sala ${room.RoomId}`);
                        socket.send(JSON.stringify({
                            action_type: "join",
                            value: {
                                name: playerName,
                                roomId: room.RoomId
                            }
                        }));
                    };
                }

                li.appendChild(descripcion);
                li.appendChild(boton);
                lista.appendChild(li);
            });
            console.log(" Renderizado de salas completo");
        }
        catch (err) {
            console.error("❌ Error al renderizar salas:", err);
        }

    }

    // Eventos para botones de acción
    document.getElementById("crearSalaBtn").addEventListener("click", () => {
        socket.send(JSON.stringify({
            action_type: "create",
            value: { name: playerName }
        }));
    });
</script>
