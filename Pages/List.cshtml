@page
@model LobbyModel
@{
    ViewData["Title"] = "Lobby";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <h2 class="text-center mb-4">🎮 Bienvenido: @Model.NombreJugadorActual</h2>
    <div id="mensajeBienvenida" class="alert alert-success alert-dismissible fade show d-none text-center" role="alert">
        <span id="textoMensaje"></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>


    <div class="row">
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Ranking de Jugadores</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Victorias</th>
                                <th>Empates</th>
                                <th>Partidas</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stats in Model.Ranking)
                            {
                                <tr>
                                    <td>@stats.Player?.Name</td>
                                    <td>@stats.Victorias</td>
                                    <td>@stats.Empates</td>
                                    <td>@stats.PartidasJugadas</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Salas disponibles</h5>
                    <form method="post" asp-page-handler="CrearRoom" class="d-inline">
                        <button class="btn btn-outline-light btn-sm">➕ Crear nueva sala</button>
                    </form>
                </div>

                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><strong>Room #1</strong> — 🟢 1 jugador esperando</span>
                            <form method="post" asp-page-handler="Unirse1">
                                <button class="btn btn-success btn-sm">Unirse</button>
                            </form>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><strong>Room #2</strong> — 🔴 2 jugadores (en partida)</span>
                            <button class="btn btn-danger btn-sm" disabled>Sala llena</button>
                        </li>

                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><strong>Room #3</strong> — ⚪ Vacía</span>
                            <form method="post" asp-page-handler="Unirse3">
                                <button class="btn btn-primary btn-sm">Unirse</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    const playerName = "@TempData["PlayerName"]";
    const socket = new WebSocket(`ws://localhost:9001/${playerName}`);

    socket.onopen = () => {
        console.log(`Conectado como ${playerName}`);
        socket.send(JSON.stringify({
            action_type: "identify",
            value: { name: playerName }
        }));
    };

    socket.onmessage = event => {
        const data = JSON.parse(event.data);
        if (data.action === "welcome") {
            const mensajeDiv = document.getElementById("mensajeBienvenida");
            const textoSpan = document.getElementById("textoMensaje");

            textoSpan.textContent = data.msg;
            mensajeDiv.classList.remove("d-none");
            setTimeout(() => {
                mensajeDiv.classList.add("d-none");
            }, 3000);
        }
    };
</script>
